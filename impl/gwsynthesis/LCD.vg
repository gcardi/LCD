module framebuffer_fifo (
  fifo_write_enable_Z,
  fifo_read_enable,
  n559_6_3,
  LCD_CLK_d,
  psram_clk,
  fifo_write_data,
  fifo_empty,
  fifo_full,
  fifo_almost_empty,
  fifo_almost_full,
  fifo_read_data
)
;
input fifo_write_enable_Z;
input fifo_read_enable;
input n559_6_3;
input LCD_CLK_d;
input psram_clk;
input [31:0] fifo_write_data;
output fifo_empty;
output fifo_full;
output fifo_almost_empty;
output fifo_almost_full;
output [31:0] fifo_read_data;
wire VCC;
wire GND;
  \~fifo.framebuffer_fifo  fifo_inst (
    .fifo_write_enable_Z(fifo_write_enable_Z),
    .fifo_read_enable(fifo_read_enable),
    .n559_6_3(n559_6_3),
    .LCD_CLK_d(LCD_CLK_d),
    .psram_clk(psram_clk),
    .fifo_write_data(fifo_write_data[31:0]),
    .fifo_empty(fifo_empty),
    .fifo_full(fifo_full),
    .fifo_almost_empty(fifo_almost_empty),
    .fifo_almost_full(fifo_almost_full),
    .fifo_read_data(fifo_read_data[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* framebuffer_fifo */
