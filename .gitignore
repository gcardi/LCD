# Gowin IDE: per-user settings and generated implementation results
*.gprj.user
/impl/

# Gowin IP Generator: keep .ipc files and generated synthesis wrappers,
# discard regeneration reports, templates and simulation netlists.
**/temp/
*.mod
*.vo
*_tmp.v

# Open-source Gowin flow (Yosys, nextpnr-gowin and Apicula/Lushay Labs)
/build/
/build-*/
/out/
*.synth.json
*.pnr.json
*.timing.json
*.fs
*.bin
*.binx
# ...tranne l'immagine font: e' il file che openFPGALoader vuole in
# --user-flash, quindi va versionata come il .fi e il .mem.
!/fonts/user_flash_fonts.bin
# Il .fi e' una trascrizione dell'immagine, non un sorgente: lo genera
# program_tang_nano_flash.ps1 in un temporaneo quando serve a Gowin.
*.fi

# Simulation: build artefacts, and pre-fix sources that run_sim.ps1 regenerates
# from git rather than keeping a second divergent copy of them here.
/sim/build/
/sim/legacy/

# Simulation and waveform output
*.vvp
*.fst
*.vcd

# STM32 CMake/Ninja/GCC reproducible outputs (including nested projects).
/stm32/**/build/
/stm32/**/build-*/
/stm32/**/cmake-build-*/
/stm32/**/out/
/stm32/**/CMakeFiles/
/stm32/**/.cmake/
/stm32/**/CMakeCache.txt
/stm32/**/cmake_install.cmake
/stm32/**/build.ninja
/stm32/**/rules.ninja
/stm32/**/.ninja_deps
/stm32/**/.ninja_log
/stm32/**/*.o
/stm32/**/*.obj
/stm32/**/*.a
/stm32/**/*.elf
/stm32/**/*.hex
/stm32/**/*.map
/stm32/**/*.d
/stm32/**/*.i
/stm32/**/*.lst
/stm32/**/*.s19
/stm32/**/*.srec
/stm32/**/*.su
/stm32/**/*.cyclo
/stm32/**/compile_commands.json

# Local CMake/STM32/editor state. Keep CMakePresets.json, .ioc, source,
# linker scripts, Drivers, and shareable .vscode launch/tasks/settings files.
/stm32/**/CMakeUserPresets.json
/stm32/**/.mxproject
/stm32/**/.cache/
/stm32/**/.vscode/.browse.c_cpp.db*
/stm32/**/.vscode/ipch/
/stm32/**/.vscode/.cortex-debug*

# Operating-system and editor files
.DS_Store
Thumbs.db
*~
